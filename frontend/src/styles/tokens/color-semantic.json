      "warning": { "$value": "{color.feedback.warning.2}" }, "warning-subtle": { "$value": "{color.feedback.warning.1}" }, "warning-strong": { "$value": "{color.feedback.warning.3}" },
      "error": { "$value": "{color.feedback.error.1}" }, "error-subtle": { "$value": "{color.feedback.error.1}" }, "error-strong": { "$value": "{color.feedback.error.3}" }
    },
    "gradient": {
      "greenblue-start": { "$value": "#24E191" }, "greenblue-end": { "$value": "#65E3FF" }
